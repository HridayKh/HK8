; number representation: 
;	hex: 0xAb
; 	decimal: 1234
;	binary: .0010

; define variables like this
#define outpath 100		; use them like `$outPath`
#define aR r0			; define first operation
#define a 7		    	; define first operation
#define bR r1			; define second operation
#define b 10			; define second operation

; execution starts at whatever label is address 0
; need to be in address order
; syntax: address name:
; note: indentation in line is optional but instruction separator is new line
; represent label's address using :labelName
; other than the main address 0 label, optional to include teh address
; labels are case insensitive, I recommend camelCase as convention

0 main:				; --- Setup ---
	IMM	r15 0		; Clean up default 7-segment display from garbage to 0
	IMM	$aR $a		; Multiplier = 7
	IMM	$bR $b		; Multiplicand = 10
	IMM	r2 0		; Result Accumulator = 0
	ALU	r2		    ; Set ALU Output to R2

10 loop:			; --- Main Loop ---
	CMP	$aR R15  	; Check if multiplier is 0
	JZ	:end		; If zero, we are done

	ADD r2 $bR		; R2 (ALU_OUT) = R2 + $aR

	ALU	R0		    ; Switch ALU output to R0 to decrement it
	DEC	R0  		; R0 = R0 - 1

	ALU	R2		    ; Switch ALU output back to R2 for the next addition
	JMP	:loop		; Repeat

; include files, this line will be replaces by the contents of other files
; it will keep looping until are includes are resolved
#include /home/hridaykh/Code/HK8/hk8/src/main/resources/example_include.hk8
